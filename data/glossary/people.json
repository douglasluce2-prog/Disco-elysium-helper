      ],
      "caseSensitive": true,
      "commonWord": true,
      "hideUntilSeen": true,
      "short": "The man found dead on the Martinaise boardwalk; he fell through a rotten plank and struck his head on a metal bench, an empty vodka bottle beside him.",
      "details": "His body lies by a hole in the creaking boardwalk with a chewing gum wrapper clutched in his fist, and a library card issued to someone named Billie Méjean in his pocket.",
      "spoiler": "He is Billie Méjean's husband. He was often in some kind of trouble, and he had borrowed books on his wife's library card, which is how the card leads you to their apartment in the Capeside Apartments.",
      "seeAlso": [
        "billie-mejean",
