    {
      "id": "tequila-sunset",
      "term": "Tequila Sunset",
      "aliases": [
        "Officer Sunset",
        "Officer Tequila Sunset",
        "Tequila"
      ],
      "caseSensitive": true,
      "commonWord": true,
      "short": "A grand name Harry gave himself during the drinking binge that wiped his memory; once you rediscover it, you can choose to go by it.",
      "details": "You start the game not knowing it, but your skills drop hints, and people who met you during the binge, like Idiot Doom Spiral, still call you 'Tequila'. Once you know the name you can introduce yourself with it, and even use it as your callsign on the radio, where you become 'Officer Sunset'.\n\nThe name is a pun on the Tequila Sunrise cocktail: as several voices point out, this is a sunset, not a sunrise, because its owner is burning out.",
      "inspiredBy": "The Tequila Sunrise cocktail.",
      "spoiler": "Idiot Doom Spiral can tell the whole tale of how Tequila Sunset rolled into Martinaise the Friday before and partied with him, but only after you have found out what happened to your motor carriage.",
      "seeAlso": [
        "harry",
        "personal-brand-strategist",
