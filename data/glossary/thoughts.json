        "dolores-dei",
        "thought-cabinet",
        "empathy"
      ]
    },
    {
      "id": "remote-viewer",
      "term": "Remote Viewer",
      "aliases": [
        "Remote Viewer Du Bois"
      ],
      "short": "A Thought you can be offered after repeatedly claiming psychic insight: Inland Empire 'inducts' you into the Remote Viewers Division.",
      "details": "Every time you explain things by extrasensory perception, ghosts or 'the veil', the game keeps count. After a few such claims, Inland Empire asks whether you feel something para-natural, then has you close your eyes and tune in to 'RVD HQ' while Kim looks on, unimpressed. You can discard the thought at several points, or let it connect and add Remote Viewer to your Thought Cabinet.\n\nWith it, extra para-natural dialogue options open up around Martinaise.",
      "inspiredBy": "Remote viewing, the supposed psychic ability to see distant places, once studied by US military and intelligence programmes.",
      "seeAlso": [
        "remote-viewers-division",
        "inland-empire",
        "thought-cabinet"
      ]
    },
    {
      "id": "sorry-cop",
      "term": "Sorry Cop",
      "caseSensitive": true,
      "short": "A Thought offered when you keep apologising and running yourself down: Suggestion announces that your copotype is the Sorry Cop.",
      "details": "The game quietly counts how often you apologise or call yourself a failure. Once you've done it enough, Suggestion makes your copotype 'official' and offers you the thought.\n\nYou can also introduce yourself as the Sorry Cop in conversation.",
      "seeAlso": [
        "copotype",
        "suggestion",
        "superstar-cop",
        "thought-cabinet"
      ]
    },
    {
      "id": "superstar-cop",
      "term": "Superstar Cop",
      "caseSensitive": true,
      "short": "A Thought offered when you keep bragging about yourself: Composure declares you the world's first celebrity police officer.",
      "details": "The game counts your boastful, attention-seeking choices. Once there are enough, Composure confirms that you're a Superstar Cop and invites you to shout 'action' and reinvent your messy life as a star vehicle.",
      "seeAlso": [
        "copotype",
        "composure",
        "sorry-cop",
        "thought-cabinet"
      ]
    },
