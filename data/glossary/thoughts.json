    {
      "id": "ace-s-high",
      "term": "Ace's High",
      "aliases": [
        "Aces High"
      ],
      "short": "A Thought you get by high-fiving Kim after the hanged man is brought down.",
      "details": "How to get it: High-five Kim after you successfully shoot down the body.\n\nWhile researching (2h 45m): +1 Empathy towards Kim. Once internalized: +1 Empathy towards Kim, +1 Esprit de Corps.",
      "spoiler": "Kim first offers one after you get the body down from the tree behind the Whirling-in-Rags. With the Thought internalized, you can ask Kim whether his jacket is from the revolutionary air brigades.",
      "seeAlso": [
        "ace-s-low",
        "kim-kitsuragi",
        "revolution",
        "aerostatic",
        "precinct-57"
      ]
    },
    {
      "id": "ace-s-low",
      "term": "Ace's Low",
      "aliases": [
        "Aces Low"
      ],
      "short": "A variant of Ace's High: high-five Kim and wait for him to deliver the low one.",
      "details": "How to get it: High-five Kim after the body comes down and wait for the 'Ace's Low' (needs Interfacing 5+).\n\nWhile researching (2h 45m): +2 Empathy towards Kim. Once internalized: +2 Empathy towards Kim, +1 Esprit de Corps.",
      "seeAlso": [
        "ace-s-high",
        "kim-kitsuragi"
      ]
    },
    {
      "id": "art-cop",
      "term": "Art Cop",
      "short": "A Thought and copotype for a detective who judges everything as art: half art critic, half cop.",
      "details": "Conceptualization offers it once you have made enough artsy or critical remarks about paintings, music, books and buildings. It urges you to hunt down not just street criminals but trite, derivative artists and writers too. Show off your taste and people like Kim and Cindy may start calling you Art Cop.",
      "seeAlso": [
        "copotype",
        "conceptualization",
        "thought-cabinet"
      ]
    },
    {
      "id": "boring-cop",
      "term": "Boring Cop",
      "aliases": [
        "Regular Cop"
      ],
      "caseSensitive": true,
      "short": "A copotype Thought Drama offers if you keep choosing the plain, by-the-book answers; Drama announces that your copotype is 'Regular Cop'.",
      "details": "Picking dull, safe options throughout the game quietly builds up this copotype. Eventually Drama teases you for always taking 'the regular, please, the brown', and offers to make it official. You can opt in, which adds the Boring Cop thought to your Thought Cabinet, or opt out.\n\nElsewhere, when Suggestion asks you to guess your copotype, you can suggest Regular Cop; Suggestion insists you are the Sorry Cop instead.",
      "seeAlso": [
        "copotype",
        "drama",
        "thought-cabinet"
      ]
    },
    {
      "id": "coach-physical-instrument",
      "term": "Coach Physical Instrument",
      "caseSensitive": true,
      "short": "A Thought where Physical Instrument becomes your sports coach, after embarrassing yourself at pétanque.",
      "details": "How to get it: Fail the pétanque red check with Gaston and René (needs Physical Instrument 2+).\n\nWhile researching (40m): -2 Encyclopedia. Once internalized: +2 Physical Instrument when your shirt slot is empty; -1 Encyclopedia.",
      "seeAlso": [
        "physical-instrument",
        "thought-cabinet",
        "thought"
      ]
    },
    {
      "id": "kingdom-of-conscience",
      "term": "Kingdom of Conscience",
      "caseSensitive": true,
      "short": "The moralist Thought: faith in slow reform and 'real democracy' someday.",
      "details": "How to get it: Earn 4 moralist points, or wear the Interisolary Trousers.\n\nWhile researching (1h 25m): -2 Half Light. Once internalized: Moralist dialogue options heal 1 Morale; Volition and Logic learning caps raised to 5.",
